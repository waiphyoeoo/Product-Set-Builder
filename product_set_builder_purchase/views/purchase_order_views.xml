<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_product_set_view_form" model="ir.ui.view">
        <field name="name">purchase.order.product_set.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <button name="%(product_set_builder.action_add_product_set)d"
                        invisible="state not in ['draft', 'sent', 'purchase']"
                        string="Add Product Set"
                        type="action"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>