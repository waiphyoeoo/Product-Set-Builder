<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_product_set" model="ir.ui.view">
        <field name="name">view_picking_form_product_set</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="inside">
                <button name="%(product_set_builder.action_add_product_set)d"
                        invisible="state not in ['draft']"
                        string="Add Product Set"
                        type="action"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>